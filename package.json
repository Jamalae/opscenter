{
  "name": "opscenter",
  "version": "1.0.0",
  "private": true,
  "description": "Static operations dashboard for GitHub Pages / GoDaddy. E2E tested with Cypress and Puppeteer.",
  "scripts": {
    "serve": "http-server . -p 8080 -c-1 --silent",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test:e2e": "start-server-and-test serve http://localhost:8080 cy:run",
    "test:smoke": "node tests/puppeteer/smoke.js",
    "test:smoke:served": "start-server-and-test serve http://localhost:8080 test:smoke",
    "test": "npm run test:e2e"
  },
  "devDependencies": {
    "cypress": "^15.17.0",
    "http-server": "^14.1.1",
    "puppeteer": "^25.1.0",
    "start-server-and-test": "^3.0.11"
  }
}
